---
import Badge from './Badge.astro';
import { formatDate, isoDate } from '../consts';
const { post } = Astro.props;
const d = post.data;
---
<article class="row">
  <time class="row__date" datetime={isoDate(d.publishedAt)}>{formatDate(d.publishedAt)}</time>
  <div class="row__kind"><Badge slug={d.categories[0]} /></div>
  <div class="row__body">
    <h3 class="row__title"><a href={`/news/${post.id}`}>{d.title}</a></h3>
    <p class="row__desc">{d.description}</p>
  </div>
</article>
