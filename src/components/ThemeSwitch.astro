---
// Three states, matching the three token blocks in global.css.
---
<div class="segmented" role="group" aria-label="Colour theme">
  <button class="segmented__option" type="button" data-theme-option="system" aria-pressed="true" title="Match system">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
    <span class="visually-hidden">Match system</span>
  </button>
  <button class="segmented__option" type="button" data-theme-option="light" aria-pressed="false" title="Light">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path></svg>
    <span class="visually-hidden">Light</span>
  </button>
  <button class="segmented__option" type="button" data-theme-option="dark" aria-pressed="false" title="Dark">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.7 8.7 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z"></path></svg>
    <span class="visually-hidden">Dark</span>
  </button>
</div>
